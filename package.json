{
  "name": "linkguard",
  "version": "0.1.0",
  "description": "MCP connector that checks links, scam messages, official sites and packages, incl. AI-recommendation poisoning",
  "main": "src/http.ts",
  "scripts": {
    "start": "node src/http.ts",
    "stdio": "node src/stdio.ts",
    "test": "node test/unit.ts && node test/smoke.ts",
    "test:unit": "node test/unit.ts",
    "test:e2e": "node test/smoke.ts",
